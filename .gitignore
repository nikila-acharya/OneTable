# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# PRD §10.4 requires the blank template to be committed; .env* would swallow it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# WP build/install logs (local only)
npm-install.log
build.log

# Playwright (t_02ae1826) — reports and local run artifacts
/test-results/
/playwright-report/
/blob-report/
npm-pw-install.log
npm-pw-browser.log

# --- Root-level strays from probe/debug sessions (local only) --------------
# Verified project status lives in docs/, ADRs and CI - never in a root report
# file. These patterns stop a future `git add .` from committing a stale
# "COMPLETE ✅" claim: PROJECT-SUMMARY.md asserted M6 shipped when nothing in it
# had a caller (docs/decisions/118).
/PROJECT-SUMMARY.md
/BUILD_REPORT.md
/COMPLETION-STATUS.md
/M[0-9]-*.md
/M[0-9]*-BUILD-REPORT.md
/WP-*-BUILD-REPORT.md
/WP-*-SUMMARY.md
*-BUILD-REPORT.md

# Session artefacts that must never be tracked (cookies/CSRF are credentials).
/local-cookies.txt
/lcsrf.json
/.hermes-tmp.*
/dz*.txt
/draft*.json
/test-output.txt

# Root-level session scratch (cookies, CSRF, probe payloads) - never tracked.
/*.txt
!/README.txt
