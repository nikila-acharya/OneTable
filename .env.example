# PRD §10.4 environment variables. Blank values only — never commit a secret.
# Copy to .env.local for development. The names below are the contract; the code
# reads these first (see src/agent/runtime.ts -> llmProvider()/agentModel()).

# --- Core -------------------------------------------------------------------
DATABASE_URL=
ENCRYPTION_KEY=
AUTH_SECRET=

# --- Data sources -----------------------------------------------------------
# USDA FoodData Central.
FDC_API_KEY=

# --- LLM (ADR-016: OpenRouter + Claude 3.5 Sonnet) --------------------------
# Provider: openrouter | openai | anthropic. Anything unrecognised falls back
# to openrouter rather than failing later at request time.
LLM_PROVIDER=openrouter
LLM_API_KEY=

# Default model for every agent; defaults to anthropic/claude-3.5-sonnet-20241022.
AGENT_MODEL_DEFAULT=
# Optional per-agent override: AGENT_MODEL_<UPPERCASE_NAME>.
# Roles: COORDINATOR, SETUP, SCOUT, PLANNER, GROCERY, ACTIVITY, REVIEWER, GUARDIAN.
# AGENT_MODEL_GUARDIAN=
# AGENT_MODEL_SCOUT=

# Legacy spellings still honoured as fallbacks (PRD names above win if both set):
#   AGENT_LLM_PROVIDER, AGENT_LLM_MODEL, <NAME>_MODEL  e.g. SCOUT_MODEL
# Prefer the PRD names in new configuration.

# Recipe-import parser model (M2).
PARSER_MODEL=

# --- Cost ceilings ----------------------------------------------------------
# NOTE: not enforced anywhere yet. The runtime only implements per-run budgets
# (25 tool calls / 4 delegations / 3 planner calls); no code reads these two, so
# a monthly cap set here currently has no effect. Tracked as a gap.
AGENT_MONTHLY_TOKEN_BUDGET_FREE=
AGENT_MONTHLY_TOKEN_BUDGET_HOUSEHOLD=

# --- Session lifetime (Auth.js v5, JWT strategy) ----------------------------
# Credentials sign-in cannot use database sessions, so sessions are JWTs and
# cannot be revoked early: maxAge IS the revocation window (PV03).
# maxAge = idle seconds before a token stops working; updateAge = how often it
# is re-issued while in use. Defaults shown.
AUTH_SESSION_MAX_AGE_SECONDS=900
AUTH_SESSION_UPDATE_AGE_SECONDS=300

# --- Instacart handoff (optional) ------------------------------------------
INSTACART_API_KEY=
FEATURE_INSTACART=false

# --- Email (auth invites/resets) -------------------------------------------
# Absent => email sending is disabled and addresses are verified directly.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Observability ---------------------------------------------------------
# GET /api/monitoring/status reports whether these are SET (booleans only, the
# values are never returned). Unset => alerting and error reporting are inert.
# Generate a value locally, e.g. `openssl rand -hex 24`; never commit it.
MONITORING_TOKEN=
#
# src/lib/analytics.ts and src/lib/audit.ts remain library code with no
# production callers; src/lib/monitoring.ts is NOT what backs the status route
# (see the header comment in src/app/api/monitoring/status/route.ts for why).
DATADOG_API_KEY=
PAGERDUTY_KEY=
